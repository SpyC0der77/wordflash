{
  "name": "wordflash-monorepo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter wordflash run dev",
    "dev:web": "pnpm --filter wordflash run dev",
    "build": "pnpm --filter @wordflash/core run build && pnpm --filter wordflash run build",
    "build:web": "pnpm --filter @wordflash/core run build && pnpm --filter wordflash run build",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "prepare": "pnpm --filter @wordflash/core run build"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "nuqs": "^2.10.2"
  },
  "packageManager": "pnpm@12.14.0"
}
