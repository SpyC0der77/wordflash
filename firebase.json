{
  "functions": [
    {
      "source": "functions",
      "codebase": "extract",
      "predeploy": ["pnpm --dir functions run build"]
    }
  ],
  "hosting": {
    "source": "apps/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "frameworksBackend": {
      "region": "us-central1",
      "omit": true
    },
    "rewrites": [
      {
        "source": "/api/extract",
        "function": {
          "functionId": "extract",
          "region": "us-central1"
        }
      }
    ]
  }
}
